# Copy to .env.local and fill in. .env.local is git-ignored.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives messages from the contact form.
# While sending from onboarding@resend.dev (no verified domain), Resend only
# delivers to the email address your Resend account was created with.
CONTACT_TO_EMAIL=

# Optional. Sender shown on the email. Needs a domain verified at
# https://resend.com/domains, e.g. "Portfolio <hello@yourdomain.com>".
# Defaults to "Portfolio <onboarding@resend.dev>".
CONTACT_FROM_EMAIL=
